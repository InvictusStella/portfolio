---
// Plain list of projects. Task 7 turns this section into the star chart.
import { ui, type Lang } from '../i18n/ui';
import type { Project } from '../lib/github';

interface Props {
	projects: Project[];
	lang: Lang;
}

const { projects, lang } = Astro.props;
---

<section class="projects" id="projects" aria-labelledby="projects-heading">
	<h2 id="projects-heading">{ui.projectsHeading[lang]}</h2>
	{
		projects.length === 0 ? (
			<p class="projects__empty">{ui.projectsComingSoon[lang]}</p>
		) : (
			<ol class="projects__list">
				{projects.map((p) => (
					<li class="panel">
						<h3>
							<a href={p.url}>{p.title}</a>
						</h3>
						{p.description && <p>{p.description}</p>}
						<p class="projects__meta">
							{p.language && <span>{p.language}</span>}
							<span aria-label={`${p.stars} GitHub stars`}>★ {p.stars}</span>
						</p>
						<p class="projects__links">
							<a href={p.url}>{ui.viewCode[lang]}</a>
							{p.homepage && <a href={p.homepage}>{ui.liveSite[lang]}</a>}
						</p>
					</li>
				))}
			</ol>
		)
	}
</section>

<style>
	.projects {
		max-width: 52rem;
		padding: 6rem var(--gutter);
		margin-left: clamp(0rem, 6vw, 6rem);
	}

	h2 {
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		margin: 0 0 1.5rem;
	}

	.projects__list {
		display: grid;
		gap: 2.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	h3 {
		font-size: 1.2rem;
		margin: 0 0 0.35rem;
	}

	h3 a {
		color: var(--text);
		text-decoration: none;
	}

	h3 a:hover {
		text-decoration: underline;
	}

	p {
		margin: 0 0 0.35rem;
	}

	.projects__meta {
		display: flex;
		gap: 1rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.projects__links {
		display: flex;
		gap: 1.25rem;
	}

	.projects__empty {
		color: var(--text-muted);
	}
</style>

---
import type { Profile } from '../content/profile';
import { ui, type Lang } from '../i18n/ui';

interface Props {
	profile: Profile;
	lang: Lang;
}

const { profile, lang } = Astro.props;
---

<header class="hero" id="top">
	<!--
		The stage is pinned while the hero's extra screen scrolls by (the "departure zone").
		Pinning only happens with WebGL and motion allowed; otherwise the hero is one screen tall.
	-->
	<div class="hero__stage">
		<!--
			CSS sun: shown until the WebGL sun is ready (and for visitors without WebGL).
			The 3D scene measures this element to place its sun in exactly the same spot.
		-->
		<div class="hero__sun" aria-hidden="true"></div>
		<div class="hero__text" data-departure-fade>
			<h1>{profile.name}</h1>
			<p class="hero__tagline">{profile.tagline[lang]}</p>
		</div>
		<a class="hero__hint" href="#about" data-departure-fade>
			{ui.scrollHint[lang]}
			<span aria-hidden="true">↓</span>
		</a>
	</div>
</header>

<style>
	.hero__stage {
		position: relative;
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
		justify-items: center;
		align-items: center;
		padding: var(--gutter);
		padding-bottom: 2rem;
		text-align: center;
	}

	/* Departure zone: only with WebGL (class set before first paint) and motion allowed. */
	@media (prefers-reduced-motion: no-preference) {
		:global(.webgl) .hero {
			height: 200svh;
		}

		:global(.webgl) .hero__stage {
			position: sticky;
			top: 0;
			height: 100svh;
		}
	}

	.hero__sun {
		--size: min(90vw, 88svh, 56rem); /* +40% on large screens, as much as fits on laptops, +15% on phones */
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--size);
		height: var(--size);
		translate: -50% -52%;
		border-radius: 50%;
		/* Bright centre, darker redder edge ("limb darkening") so it reads as a sphere. */
		background: radial-gradient(
			circle,
			#ffcc73 0%,
			var(--sun-core) 35%,
			#ff9a3c 62%,
			#d9541a 82%,
			#a33212 100%
		);
		box-shadow:
			0 0 calc(var(--size) * 0.12) calc(var(--size) * 0.04) rgba(255, 170, 70, 0.55),
			0 0 calc(var(--size) * 0.45) calc(var(--size) * 0.12) var(--sun-glow);
		transition: opacity 0.6s ease;
	}

	/* Hidden (but still measurable) once the WebGL sun has drawn its first frame. */
	:global(.scene-ready) .hero__sun {
		opacity: 0;
	}

	/*
	 * Soft, borderless shadow behind the text: a blurred dark shape the size of the
	 * text block, so every letter gets the same backing and the edges melt into the sun.
	 * 74% warm dark keeps the tagline at WCAG AA contrast over the sun's bright centre.
	 */
	.hero__text {
		position: relative;
		isolation: isolate;
		max-width: 44rem;
		padding: 4rem 4.5rem;
		text-shadow: 0 2px 18px rgba(28, 10, 4, 0.7);
	}

	.hero__text::before {
		content: '';
		position: absolute;
		inset: 1.75rem 0.75rem;
		z-index: -1;
		border-radius: 4rem;
		background: rgba(28, 10, 4, 0.7);
		filter: blur(40px);
	}

	[data-departure-fade] {
		opacity: var(--departure-fade, 1);
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
	}

	.hero__tagline {
		font-size: clamp(1.1rem, 2.5vw, 1.4rem);
		color: var(--text);
		margin: 0;
	}

	.hero__hint {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		color: var(--text);
		text-decoration: none;
		/* It can sit over the sun's bright lower edge on laptop screens. */
		isolation: isolate;
		padding: 0.5rem 1rem;
		text-shadow: 0 0 10px rgba(28, 10, 4, 0.9);
	}

	.hero__hint::before {
		content: '';
		position: absolute;
		inset: -0.75rem -1.25rem;
		z-index: -1;
		border-radius: 2rem;
		background: rgba(28, 10, 4, 0.75);
		filter: blur(14px);
	}

	.hero__hint span {
		font-size: 1.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__hint span {
			animation: drift 2s ease-in-out infinite;
		}
	}

	@keyframes drift {
		50% {
			transform: translateY(6px);
		}
	}
</style>

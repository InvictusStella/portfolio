---
import type { Profile } from '../content/profile';
import { ui, type Lang } from '../i18n/ui';

interface Props {
	profile: Profile;
	lang: Lang;
}

const { profile, lang } = Astro.props;
---

<header class="hero" id="top">
	<!-- CSS stand-in; the WebGL sun replaces it in Task 10. -->
	<div class="hero__sun" aria-hidden="true"></div>
	<div class="hero__text">
		<h1>{profile.name}</h1>
		<p class="hero__tagline">{profile.tagline[lang]}</p>
	</div>
	<a class="hero__hint" href="#about">
		{ui.scrollHint[lang]}
		<span aria-hidden="true">↓</span>
	</a>
</header>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
		justify-items: center;
		align-items: center;
		padding: var(--gutter);
		padding-bottom: 2rem;
		text-align: center;
	}

	.hero__sun {
		--size: min(78vw, 70svh, 40rem);
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--size);
		height: var(--size);
		translate: -50% -55%;
		border-radius: 50%;
		/* Bright centre, darker redder edge ("limb darkening") so it reads as a sphere. */
		background: radial-gradient(
			circle,
			#fff4d6 0%,
			var(--sun-core) 35%,
			#ff9a3c 62%,
			#d9541a 82%,
			#a33212 100%
		);
		box-shadow:
			0 0 calc(var(--size) * 0.12) calc(var(--size) * 0.04) rgba(255, 170, 70, 0.55),
			0 0 calc(var(--size) * 0.45) calc(var(--size) * 0.12) var(--sun-glow);
	}

	/* Soft, borderless haze behind the text: dims the sun without boxing it in. */
	.hero__text {
		position: relative;
		max-width: 44rem;
		padding: 4rem 4.5rem;
		/* closest-side: fades out exactly at the edges of this box, so no visible bands. */
		background: radial-gradient(
			closest-side,
			rgba(3, 4, 12, 0.4) 0%,
			rgba(3, 4, 12, 0.4) 55%,
			rgba(3, 4, 12, 0.2) 78%,
			transparent 100%
		);
		text-shadow: 0 2px 18px rgba(3, 4, 12, 0.7);
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
	}

	.hero__tagline {
		font-size: clamp(1.1rem, 2.5vw, 1.4rem);
		color: var(--text);
		margin: 0;
	}

	.hero__hint {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.hero__hint span {
		font-size: 1.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__hint span {
			animation: drift 2s ease-in-out infinite;
		}
	}

	@keyframes drift {
		50% {
			transform: translateY(6px);
		}
	}
</style>

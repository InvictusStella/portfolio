---
import type { Profile } from '../content/profile';
import { ui, type Lang } from '../i18n/ui';

interface Props {
	profile: Profile;
	lang: Lang;
}

const { profile, lang } = Astro.props;
---

<header class="hero" id="top">
	<div class="hero__text">
		<h1>{profile.name}</h1>
		<p class="hero__tagline">{profile.tagline[lang]}</p>
	</div>
	<a class="hero__hint" href="#about">
		{ui.scrollHint[lang]}
		<span aria-hidden="true">↓</span>
	</a>
</header>

<style>
	.hero {
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
		align-items: center;
		padding: var(--gutter);
		padding-bottom: 2rem;
	}

	.hero__text {
		max-width: 40rem;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
	}

	.hero__tagline {
		font-size: clamp(1.1rem, 2.5vw, 1.4rem);
		color: var(--text-muted);
		margin: 0;
	}

	.hero__hint {
		justify-self: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.hero__hint span {
		font-size: 1.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__hint span {
			animation: drift 2s ease-in-out infinite;
		}
	}

	@keyframes drift {
		50% {
			transform: translateY(6px);
		}
	}
</style>

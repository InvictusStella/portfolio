---
// The 3D scene's canvas. It sits behind all content; the scene code loads only
// after the page has loaded, and only if the WebGL check in <head> passed.
---

<canvas class="scene-canvas" aria-hidden="true"></canvas>
<!-- Warm light from the sun once it has risen off the top of the screen. -->
<div class="sunlight" aria-hidden="true"></div>
<!-- Brief blue-white flash at the height of a warp jump (strength set by the scene). -->
<div class="warp-flash" aria-hidden="true"></div>

<script>
	const root = document.documentElement;
	const canvas = document.querySelector<HTMLCanvasElement>('.scene-canvas');

	if (canvas && root.classList.contains('webgl')) {
		const start = () =>
			import('../scene/index')
				.then(({ startScene }) => startScene(canvas))
				.catch((error) => {
					// Fall back to the CSS sun and a normal one-screen hero.
					console.error('3D scene failed to start:', error);
					root.classList.remove('webgl', 'scene-ready', 'intro');
				});

		if (document.readyState === 'complete') start();
		else addEventListener('load', start, { once: true });
	}

	// Links marked data-travel ("Scroll to begin the journey", "Return to Sun") become warp
	// journeys while the 3D scene is running. Otherwise (no WebGL, reduced motion, scene not
	// up yet) nothing intercepts them and they work as plain links.
	document.addEventListener('click', (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-travel]');
		if (!link || !root.classList.contains('scene-ready')) return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		event.preventDefault();
		dispatchEvent(new CustomEvent('portfolio:travel', { detail: { to: link.dataset.travel } }));
	});
</script>

<style>
	.scene-canvas {
		display: none;
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100vh;
		z-index: -1;
		pointer-events: none;
		/* The scene is light on black: "screen" adds its light to the page and lets the
		   background gradient show through wherever the scene is dark (bloom makes the canvas opaque). */
		mix-blend-mode: screen;
	}

	:global(.webgl) .scene-canvas {
		display: block;
	}

	/* Behind the page content, so text stays readable through the flash. */
	.warp-flash {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(225, 238, 255, 0.95),
			rgba(130, 175, 255, 0.45) 35%,
			rgba(60, 100, 220, 0.12) 65%,
			transparent 85%
		);
		mix-blend-mode: screen;
		opacity: var(--warp-flash, 0);
	}

	/* Its strength (--sunlight, 0–1) is set by the scene as you scroll. */
	.sunlight {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			ellipse 80% 55% at 50% -10%,
			rgba(255, 190, 110, 0.5),
			rgba(255, 140, 60, 0.18) 45%,
			transparent 78%
		);
		opacity: var(--sunlight, 0);
	}

	/* No flight under reduced motion: the canvas scrolls away with the hero instead. */
	@media (prefers-reduced-motion: reduce) {
		.scene-canvas {
			position: absolute;
			height: 100svh;
			/* Fade the bottom so the sun's glow doesn't end in a hard line. */
			mask-image: linear-gradient(to bottom, black 75%, transparent);
		}
	}
</style>
